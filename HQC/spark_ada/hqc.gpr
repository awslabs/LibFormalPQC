with "../../libkeccak/libkeccak.gpr";
project HQC is

   for Create_Missing_Dirs use "True";
   for Source_Dirs use ("src");
   for Main use ("test_intermediates.adb", "test_kat.adb");

   type Param_Set is ("1", "3", "5");
   HQC_Param : Param_Set := External ("HQC_PARAM", "1");

   Param_Switch := ();
   case HQC_Param is
      when "1" =>
         for Object_Dir use "obj1";
         for Library_Dir use "lib1";
         Param_Switch := ("-gnateDHQC_PARAM=1");
      when "3" =>
         for Object_Dir use "obj3";
         for Library_Dir use "lib3";
         Param_Switch := ("-gnateDHQC_PARAM=3");
      when "5" =>
         for Object_Dir use "obj5";
         for Library_Dir use "lib5";
         Param_Switch := ("-gnateDHQC_PARAM=5");
   end case;

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("HQC_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   type Enabled_Kind is ("enabled", "disabled");
   Compile_Checks   : Enabled_Kind := External ("HQC_COMPILE_CHECKS", "enabled");
   Runtime_Checks   : Enabled_Kind := External ("HQC_RUNTIME_CHECKS", "enabled");
   Style_Checks     : Enabled_Kind := External ("HQC_STYLE_CHECKS", "enabled");
   Contracts_Checks : Enabled_Kind := External ("HQC_CONTRACTS", "enabled");
   Coverage_Checks  : Enabled_Kind := External ("HQC_COVERAGE", "disabled");

   type Build_Kind is ("debug", "O1", "O2", "O3", "Os", "Og", "profile");
   Build_Mode : Build_Kind := External ("HQC_BUILD_MODE", "debug");

   type Runtime_Kind is ("full", "zfp");
   Runtime_Mode : Runtime_Kind := External ("HQC_RUNTIME_MODE", "full");

   --  Extend this list to add any options for specific targets and see below
   type Target_Arch_Kind is ("unspecified", "rv32im", "rv32imc", "rv32imc_a4");
   Target_Arch : Target_Arch_Kind := External ("HQC_TARGET_ARCH", "unspecified");

   Callgraph_Switch := ("-fcallgraph-info=su,da");

   Compile_Checks_Switches := ();
   case Compile_Checks is
      when "enabled" =>
            -- All warnings on and treated as errors except
            --   Static conditional expressions (C)
            --   Suspicious modulii  (.M)
            --   Wrong order params (.P)
            --   Suspicious contracts (.T)
            --   Exception propagation (.X)
            Compile_Checks_Switches := ("-gnatwaeC.M.P.T.X");
      when others => null;
   end case;

   Coverage_Checks_Switches := ();
   case Coverage_Checks is
      when "enabled" =>
         Coverage_Checks_Switches :=
           ("--coverage");
      when others => null;
   end case;

   Runtime_Checks_Switches := ();
   case Runtime_Checks is
      when "enabled" => null;
      when others =>
         Runtime_Checks_Switches :=
           ("-gnatp"); -- Supress checks
   end case;

   Style_Checks_Switches := ();
   case Style_Checks is
      when "enabled" =>
         Style_Checks_Switches :=
           ("-gnatyyCM132-s");    -- style checks on except distinct subprogram declarations
      when others => null;
   end case;

   Contracts_Switches := ();
   case Contracts_Checks is
      when "enabled" =>
         Contracts_Switches :=
           ("-gnata", "-gnatVa"); --  Enable assertions and contracts
      when "disabled" =>
         null;
   end case;

   Build_Switches := ();
   case Build_Mode is
      when "debug" =>
         Build_Switches := ("-g",   -- Debug info
                            "-O0"); -- No optimization
      when "O1" =>
         Build_Switches := ("-O1",     -- Optimization
                            "-gnatn"); -- Enable inlining
      when "O2" =>
         Build_Switches := ("-O2",     -- Optimization
                            "-gnatn"); -- Enable inlining
      when "O3" =>
         Build_Switches := ("-O3",     -- Optimization
                            "-gnatn"); -- Enable inlining
      when "Os" =>
         Build_Switches := ("-Os");     -- Optimize for small code size, no inlining
      when "Og" =>
         Build_Switches := ("-g",
                            "-Og");
      when "profile" =>  -- Build for profiling with DTrace and Flamegraph
         Build_Switches := ("-O2", -- Optimization
                            "-g"); -- Debug info
   end case;

   --  Extend this case choice for any other target/architecture specific switches
   case Target_Arch is
      when "rv32im" =>
         Build_Switches := Build_Switches &
           ("-march=rv32im"); -- RV32IM but NO Compressed instructions
      when "rv32imc" =>
         Build_Switches := Build_Switches &
           ("-march=rv32imc"); -- RV32IM with Compressed instructions
      when "rv32imc_a4" =>
         Build_Switches := Build_Switches &
           ("-march=rv32imc") & -- Compressed instructions but all BBs on 4-byte alignment
           ("-falign-functions=4") &
           ("-falign-jumps=4") &
           ("-falign-loops=4") &
           ("-falign-labels=4");
      when others => null;
   end case;

   case Runtime_Mode is
      when "zfp" =>
         for Runtime ("Ada") use "zfp";
         for Excluded_Source_Files use ("hqc-debug.ads", "hqc-debug.adb");
      when others =>
         null;
   end case;

   package Compiler is
      for Default_Switches ("Ada") use
        Compile_Checks_Switches &
        Callgraph_Switch &
        Build_Switches &
        Runtime_Checks_Switches &
        Style_Checks_Switches &
        Contracts_Switches &
        Coverage_Checks_Switches &
        ("-gnateDSPARK_BODY_MODE=Off") &
        Param_Switch &
        ("-fstack-usage") &
        ("-ffunction-sections") & -- Create a linker section for each function
        ("-fdata-sections") &    -- Create a linker section for each data area
        ("-gnatQ");    -- Don't quit. Generate ALI and tree files even if illegalities

      for Local_Configuration_Pragmas use "hqc.adc";

   end Compiler;


   SDKROOT := External ("SDKROOT", "");
   package Linker is
      for Default_Switches ("Ada") use Coverage_Checks_Switches & ("-L" & SDKROOT & "/usr/lib");
   end Linker;


   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Prove is
      for Proof_Switches ("Ada") use ("--proof=per_path",
                                      "-j8",
                                      "--no-subprojects",
                                      "--no-global-generation",
                                      "--no-inlining",
                                      "--no-loop-unrolling",
                                      "--proof-warnings=on",
                                      "--pedantic",
                                      "--level=1",
                                      "--prover=z3,cvc5,altergo",
                                      "--timeout=20",
                                      "--memlimit=0",
                                      "--steps=300000",
                                      "--report=statistics");
   end Prove;


   --  All the main HQC entry points
   Stack_Entry_Points := ("-ehqc.hqc_keygen,hqc.hqc_encaps,hqc.hqc_decaps");

   package Stack is
      for Switches use ("-Wa", "-u 128", "-np", "-v") & Stack_Entry_Points;
   end Stack;

end HQC;
