with Interfaces; use Interfaces;
package SLH
  with SPARK_Mode => On
is
   pragma Elaborate_Body (SLH);

   --==============================================
   --  Exported constants, types, and subprograms
   --
   --  These are needed by clients, or by the
   --  specifications of child packages
   --==============================================

   --  Constants common to all parameter sets
   --  from FIPS 205 section ???
   Len2 : constant := 3;
   LG_W : constant := 4;

   --  Parameters for SLH-DSA_SHA2-256s and SLH-DSA-SHAKE-256s
   N      : constant := 32;
   H      : constant := 64;
   D      : constant := 8;
   H_Tick : constant := 8;
   A      : constant := 14;
   K      : constant := 22;
   M      : constant := 47;

   PK_Bytes  : constant := 64;
   Sig_Bytes : constant := 29_792;

   --  WOTS+ parameters derived from N and LG_W.
   --  See FIPS 205 section 5, equations 5.1 to 5.4.
   --  Len2 is a constant above, since equation 5.3 needs a
   --  logarithm, so its value is checked below instead
   W    : constant := 2**LG_W;                   --  (5.1)
   Len1 : constant := (8 * N + LG_W - 1) / LG_W; --  (5.2) Ceiling (8n / lg_w)
   Len  : constant := Len1 + Len2;               --  (5.4)

   --  When lg_w = 4, w = 16, len1 = 2n, len2 = 3, and len = 2n + 3
   pragma Assert (W = 16 and Len1 = 2 * N and Len2 = 3 and Len = 2 * N + 3);
   --  Equation 5.3: len2 = Floor (log2 (len1 * (w - 1)) / lg_w) + 1
   --  2**8 <= len1 * (w - 1) < 2**12, so log2 (len1 * (w - 1)) is in
   --  the range 8.0 .. 12.0 (excluding 12.0), and so
   --  len2 = Floor (log2 (len1 * (w - 1)) / 4) + 1 = 2 + 1 = 3
   pragma Assert (2**8 <= Len1 * (W - 1) and Len1 * (W - 1) < 2**12);

   ----------------------------------------------------------------------
   --  Parameter set validation
   ----------------------------------------------------------------------

   --  FIPS 205 section ??? requires that implementations shall confirm
   --  that only valid sets of parameters are chosen.  This can be
   --  encoded as an assertion, thus:
   pragma Assert (True); -- TBD

   --  The derived sizes. See FIPS 205 section 9 (m), Figure 16
   --  (public key) and Figure 17 (signature)
   pragma Assert (M = (H - H_Tick + 7) / 8 + (K * A + 7) / 8 + (H_Tick + 7) / 8);
   pragma Assert (PK_Bytes = 2 * N);
   pragma Assert (Sig_Bytes = (1 + K * (1 + A) + H + D * Len) * N);
   pragma Assert (H = D * H_Tick);

   subtype Byte is Unsigned_8;
   subtype I32  is Integer_32;
   subtype N32  is I32 range 0 .. I32'Last;

   --  Unconstrained (aka "Size Polymorphic") array of bytes
   type Byte_Seq is array (N32 range <>) of Byte;

   subtype Index_32  is I32 range 0 .. 31;
   subtype Bytes_32  is Byte_Seq (Index_32);

   subtype Index_N is I32 range 0 .. N - 1;
   subtype Bytes_N is Byte_Seq (Index_N);

   subtype Index_M is I32 range 0 .. M - 1;
   subtype Bytes_M is Byte_Seq (Index_M);

   --==============================================
   --  Exported types
   --==============================================

   --  SK, an SLH-DSA private key:
   --  SK.seed || SK.prf || PK.seed || PK.root (FIPS 205 Figure 15)
   SK_Bytes : constant := 4 * N;
   subtype Private_Key_Index is I32 range 0 .. SK_Bytes - 1;
   subtype Private_Key is Byte_Seq (Private_Key_Index);

   --  PK, an SLH-DSA public key: PK.seed || PK.root (Figure 16)
   subtype Public_Key_Index is I32 range 0 .. PK_Bytes - 1;
   subtype Public_Key is Byte_Seq (Public_Key_Index);

   type Key_Pair is record
      SK : Private_Key;
      PK : Public_Key;
   end record;

   --  SIG, an SLH-DSA signature: R || SIG_FORS || SIG_HT (Figure 17)
   subtype Index_Signature is N32 range 0 .. Sig_Bytes - 1;
   subtype Signature is Byte_Seq (Index_Signature);

   --  Pre-hash functions for HashSLH-DSA (FIPS 205 section 10.2.2).
   --  Section 10.2 requires a pre-hash with at least 8n = 256 bits of
   --  classical security strength against collision and second
   --  preimage attacks, which for this parameter set means a digest of
   --  at least 2n = 64 bytes, so only SHA3-512 and SHAKE256 with a
   --  512-bit output are provided.
   type Pre_Hash_Function is (PH_SHA3_512, PH_SHAKE256);

   --==============================================
   --  Exported subprograms. These subprograms
   --  form the main user-facing API for SLH
   --
   --  Where FIPS 205 generates random values, the
   --  caller supplies them as parameters. They shall
   --  be generated by an approved random bit generator
   --  (FIPS 205 sections 9.1, 9.2 and 10)
   --==============================================

   --  Input Validation Functions

   --  The context string ctx has at most 255 bytes (FIPS 205 section 10.2)
   Max_Context_Length : constant := 255;

   function Valid_Context (Ctx : in Byte_Seq) return Boolean
   is (Ctx'Length <= Max_Context_Length)
     with Global => null;

   --  The pure versions copy toByte (0, 1) || toByte (|ctx|, 1) || ctx || M,
   --  so M must be short enough for that to be a Byte_Seq
   Max_Message_Length : constant := I32'Last - 2 - Max_Context_Length;

   function Valid_Pure_Message (Msg : in Byte_Seq) return Boolean
   is (Msg'Length <= Max_Message_Length)
     with Global => null;

   --  The pre-hash versions pass M to libkeccak, whose index type
   --  excludes I32'Last
   function Valid_Pre_Hash_Message (Msg : in Byte_Seq) return Boolean
   is (Msg'Last < I32'Last)
     with Global => null;

   --  PK.seed, from a private key. The deterministic variants
   --  use this as opt_rand (FIPS 205 Algorithm 19 line 2)
   function PK_Seed_Of (SK : in Private_Key) return Bytes_N
     with Global => null,
          Post   => (for all B in Index_N => PK_Seed_Of'Result (B) = SK (2 * N + B));

   --  Main SLH API

   --  Algorithm 21. slh_keygen ()
   --  SK_Seed, SK_Prf and PK_Seed are random n-byte strings.
   function SLH_Keygen (SK_Seed : in Bytes_N;
                        SK_Prf  : in Bytes_N;
                        PK_Seed : in Bytes_N) return Key_Pair
     with Global => null;

   --  Algorithm 22. slh_sign (M, ctx, SK), hedged.
   --  Addrnd is a random n-byte string.
   function SLH_Sign (Msg    : in Byte_Seq;
                      Ctx    : in Byte_Seq;
                      SK     : in Private_Key;
                      Addrnd : in Bytes_N) return Signature
     with Global => null,
          Pre    => Valid_Context (Ctx) and Valid_Pure_Message (Msg);

   --  Algorithm 22. slh_sign (M, ctx, SK), deterministic
   function SLH_Sign_Deterministic (Msg : in Byte_Seq;
                                    Ctx : in Byte_Seq;
                                    SK  : in Private_Key) return Signature
     with Global => null,
          Pre    => Valid_Context (Ctx) and Valid_Pure_Message (Msg),
          Post   => SLH_Sign_Deterministic'Result = SLH_Sign (Msg, Ctx, SK, PK_Seed_Of (SK));

   --  Algorithm 23. hash_slh_sign (M, ctx, PH, SK), hedged.
   --  Addrnd is a random n-byte string.
   function Hash_SLH_Sign (Msg    : in Byte_Seq;
                           Ctx    : in Byte_Seq;
                           PH     : in Pre_Hash_Function;
                           SK     : in Private_Key;
                           Addrnd : in Bytes_N) return Signature
     with Global => null,
          Pre    => Valid_Context (Ctx) and Valid_Pre_Hash_Message (Msg);

   --  Algorithm 23. hash_slh_sign (M, ctx, PH, SK), deterministic
   function Hash_SLH_Sign_Deterministic (Msg : in Byte_Seq;
                                         Ctx : in Byte_Seq;
                                         PH  : in Pre_Hash_Function;
                                         SK  : in Private_Key) return Signature
     with Global => null,
          Pre    => Valid_Context (Ctx) and Valid_Pre_Hash_Message (Msg),
          Post   => Hash_SLH_Sign_Deterministic'Result =
                      Hash_SLH_Sign (Msg, Ctx, PH, SK, PK_Seed_Of (SK));

   --  Algorithm 24. slh_verify (M, SIG, ctx, PK)
   --  SIG is a Signature, so it has the length required by
   --  slh_verify_internal
   function SLH_Verify (Msg : in Byte_Seq;
                        Sig : in Signature;
                        Ctx : in Byte_Seq;
                        PK  : in Public_Key) return Boolean
     with Global => null,
          Pre    => Valid_Pure_Message (Msg),
          Post   => (if not Valid_Context (Ctx) then not SLH_Verify'Result);  --  Lines 1 to 3

   --  Algorithm 25. hash_slh_verify (M, SIG, ctx, PH, PK)
   function Hash_SLH_Verify (Msg : in Byte_Seq;
                             Sig : in Signature;
                             Ctx : in Byte_Seq;
                             PH  : in Pre_Hash_Function;
                             PK  : in Public_Key) return Boolean
     with Global => null,
          Pre    => Valid_Pre_Hash_Message (Msg),
          Post   => (if not Valid_Context (Ctx) then not Hash_SLH_Verify'Result);  --  Lines 1 to 3

   --  Correctness of SLH-DSA: a signature made with a private key from
   --  SLH_Keygen verifies with the matching public key, for any message,
   --  context string and addrnd. By the postconditions of the
   --  deterministic variants, these also cover deterministic signing.
   procedure Theorem_Correctness_Pure (SK_Seed : in Bytes_N;
                                       SK_Prf  : in Bytes_N;
                                       PK_Seed : in Bytes_N;
                                       Msg     : in Byte_Seq;
                                       Ctx     : in Byte_Seq;
                                       Addrnd  : in Bytes_N)
     with Ghost,
          Global => null,
          Pre    => Valid_Context (Ctx) and Valid_Pure_Message (Msg),
          Post   =>
            SLH_Verify (Msg,
                        SLH_Sign (Msg, Ctx, SLH_Keygen (SK_Seed, SK_Prf, PK_Seed).SK, Addrnd),
                        Ctx,
                        SLH_Keygen (SK_Seed, SK_Prf, PK_Seed).PK);

   procedure Theorem_Correctness_Pre_Hash (SK_Seed : in Bytes_N;
                                           SK_Prf  : in Bytes_N;
                                           PK_Seed : in Bytes_N;
                                           Msg     : in Byte_Seq;
                                           Ctx     : in Byte_Seq;
                                           PH      : in Pre_Hash_Function;
                                           Addrnd  : in Bytes_N)
     with Ghost,
          Global => null,
          Pre    => Valid_Context (Ctx) and Valid_Pre_Hash_Message (Msg),
          Post   =>
            Hash_SLH_Verify (Msg,
                             Hash_SLH_Sign (Msg, Ctx, PH, SLH_Keygen (SK_Seed, SK_Prf, PK_Seed).SK,
                                            Addrnd),
                             Ctx,
                             PH,
                             SLH_Keygen (SK_Seed, SK_Prf, PK_Seed).PK);

private
   subtype U16 is Unsigned_16;
   subtype U32 is Unsigned_32;
   subtype U64 is Unsigned_64;
   subtype I64 is Integer_64;

   subtype Index_128 is I32 range 0 .. 127;
   subtype Index_256 is I32 range 0 .. 255;

   subtype Index_2N is I32 range 0 .. 2 * N - 1;
   subtype Bytes_2N is Byte_Seq (Index_2N);

   subtype Index_64 is I32 range 0 .. 63;
   subtype Bytes_64 is Byte_Seq (Index_64);

   --  An address (ADRS) is a 32-byte string.
   --  See FIPS 205 section 4.2
   subtype ADRS_Bytes is Bytes_32;

   --==============================================
   --  Hash functions and Pseudorandom Functions
   --  See FIPS 205 sections 4.1 and 11.1
   --
   --  Declared here in the private part, so that
   --  they are visible to the body of SLH.KAT
   --==============================================
   package Hash
   is
      function PRF_Msg (SK_Prf : in Bytes_N; Opt_Rand : in Bytes_N; M : in Byte_Seq) return Bytes_N
        with Global => null,
             Pre    => M'First = 0 and M'Last <= I32'Last - 1;

      function H_Msg (R : in Bytes_N; PK_Seed : in Bytes_N; PK_Root : in Bytes_N; M : in Byte_Seq) return Bytes_M
        with Global => null,
             Pre    => M'First = 0 and M'Last <= I32'Last - 1;

      function PRF (PK_Seed : in Bytes_N; SK_Seed : in Bytes_N; ADRS : in ADRS_Bytes) return Bytes_N
        with Global => null;

      --  T_L hashes an L*N-byte message M_L. L is implied by M_L'Length.
      function T_L (PK_Seed : in Bytes_N; ADRS : in ADRS_Bytes; M_L : in Byte_Seq) return Bytes_N
        with Global => null,
             Pre    => M_L'First = 0 and
                       M_L'Length >= N and
                       M_L'Length mod N = 0 and
                       M_L'Last <= I32'Last - 1;

      --  Within package Hash, this function H hides the hypertree height
      --  constant SLH.H. Elsewhere, H denotes the constant, so this
      --  function must be called as Hash.H
      function H (PK_Seed : in Bytes_N; ADRS : in ADRS_Bytes; M2 : in Bytes_2N) return Bytes_N
        with Global => null;

      function F (PK_Seed : in Bytes_N; ADRS : in ADRS_Bytes; M1 : in Bytes_N) return Bytes_N
        with Global => null;

      --  PH_M, the pre-hash of M in Algorithms 23 and 25:
      --  SHA3-512 (M), or SHAKE256 (M, 512)
      function Pre_Hash (PH : in Pre_Hash_Function; Msg : in Byte_Seq) return Bytes_64
        with Global => null,
             Pre    => Msg'Last < I32'Last;
   end Hash;

   --==============================================
   --  Addresses and their member functions
   --  See FIPS 205 sections 4.2 and 4.3
   --
   --  An ADRS_Bytes value is 8 big-endian 32-bit
   --  words, numbered 0 .. 7:
   --    Word 0      : layer address
   --    Words 1 - 3 : tree address
   --    Word 4      : type
   --    Words 5 - 7 : depend on type
   --
   --  Note: in a subprogram that has a local object
   --  named ADRS, that object hides this package, so
   --  its subprograms must then be named in full
   --  (e.g. SLH.ADRS.Set_Layer_Address) or made
   --  directly visible with "use ADRS;"
   --==============================================
   package ADRS
   is
      --  Address types. See FIPS 205 section 4.2, footnote 5.
      --  The value of the type word is ADRS_Type'Pos, which is
      --  0 for WOTS_HASH up to 6 for FORS_PRF
      type ADRS_Type is (WOTS_HASH, WOTS_PK, TREE, FORS_TREE,
                         FORS_ROOTS, WOTS_PRF, FORS_PRF);

      subtype Word_Index is I32 range 0 .. 7;

      --  Word (A, W) returns the integer value of the
      --  big-endian 4-byte word A (4 * W .. 4 * W + 3).
      --  This is toInt (A[4W : 4W + 4], 4) from FIPS 205 Algorithm 2.
      function Word (A : in ADRS_Bytes; W : in Word_Index) return U32
      is (U32 (A (4 * W))     * 2**24 +
          U32 (A (4 * W + 1)) * 2**16 +
          U32 (A (4 * W + 2)) * 2**8 +
          U32 (A (4 * W + 3)))
        with Global => null;

      --  The postconditions below are the expanded notation from
      --  FIPS 205 Table 1. Each one states the new value of the bytes
      --  that are written, and that all other bytes are unchanged.

      --  ADRS <- toByte (L, 4) || ADRS[4 : 32]
      procedure Set_Layer_Address (A : in out ADRS_Bytes; L : in U32)
        with Global => null,
             Post   => Word (A, 0) = L and
                       (for all I in Index_32 =>
                          (if I not in 0 .. 3 then A (I) = A'Old (I)));

      --  ADRS <- ADRS[0 : 4] || toByte (T, 12) || ADRS[16 : 32]
      --  T is a U64, so the first 4 bytes of toByte (T, 12) are zero
      procedure Set_Tree_Address (A : in out ADRS_Bytes; T : in U64)
        with Global => null,
             Post   => Word (A, 1) = 0 and
                       Word (A, 2) = U32 (Shift_Right (T, 32)) and
                       Word (A, 3) = U32 (T and 16#FFFF_FFFF#) and
                       (for all I in Index_32 =>
                          (if I not in 4 .. 15 then A (I) = A'Old (I)));

      --  ADRS <- ADRS[0 : 16] || toByte (Y, 4) || toByte (0, 12)
      procedure Set_Type_And_Clear (A : in out ADRS_Bytes; Y : in ADRS_Type)
        with Global => null,
             Post   => Word (A, 4) = ADRS_Type'Pos (Y) and
                       (for all I in Index_32 range 20 .. 31 => A (I) = 0) and
                       (for all I in Index_32 range 0 .. 15 => A (I) = A'Old (I));

      --  ADRS <- ADRS[0 : 20] || toByte (I, 4) || ADRS[24 : 32]
      procedure Set_Key_Pair_Address (A : in out ADRS_Bytes; I : in U32)
        with Global => null,
             Post   => Word (A, 5) = I and
                       (for all J in Index_32 =>
                          (if J not in 20 .. 23 then A (J) = A'Old (J)));

      --  ADRS <- ADRS[0 : 24] || toByte (I, 4) || ADRS[28 : 32]
      procedure Set_Chain_Address (A : in out ADRS_Bytes; I : in U32)
        with Global => null,
             Post   => Word (A, 6) = I and
                       (for all J in Index_32 =>
                          (if J not in 24 .. 27 then A (J) = A'Old (J)));

      --  ADRS <- ADRS[0 : 24] || toByte (I, 4) || ADRS[28 : 32]
      procedure Set_Tree_Height (A : in out ADRS_Bytes; I : in U32)
        with Global => null,
             Post   => Word (A, 6) = I and
                       (for all J in Index_32 =>
                          (if J not in 24 .. 27 then A (J) = A'Old (J)));

      --  ADRS <- ADRS[0 : 28] || toByte (I, 4)
      procedure Set_Hash_Address (A : in out ADRS_Bytes; I : in U32)
        with Global => null,
             Post   => Word (A, 7) = I and
                       (for all J in Index_32 =>
                          (if J not in 28 .. 31 then A (J) = A'Old (J)));

      --  ADRS <- ADRS[0 : 28] || toByte (I, 4)
      procedure Set_Tree_Index (A : in out ADRS_Bytes; I : in U32)
        with Global => null,
             Post   => Word (A, 7) = I and
                       (for all J in Index_32 =>
                          (if J not in 28 .. 31 then A (J) = A'Old (J)));

      --  i <- toInt (ADRS[20 : 24], 4)
      function Get_Key_Pair_Address (A : in ADRS_Bytes) return U32
      is (Word (A, 5))
        with Global => null;

      --  i <- toInt (ADRS[28 : 32], 4)
      function Get_Tree_Index (A : in ADRS_Bytes) return U32
      is (Word (A, 7))
        with Global => null;

   end ADRS;

   --==============================================
   --  Arrays, Byte Strings, and Integers
   --  See FIPS 205 section 4.4
   --==============================================

   --  Unconstrained array of 32-bit unsigned integers,
   --  used for the result of Base_2b
   type U32_Seq is array (N32 range <>) of U32;

   package Conversions
   is
      --  Byte K of the big-endian representation of X, counting
      --  from the least significant byte, which is byte 0.
      function Byte_Of (X : in U64; K : in Natural) return Byte
      is (if K < 8 then Byte (Shift_Right (X, 8 * K) and 16#FF#) else 0)
        with Global => null;

      --  Bit K of X, where X is interpreted as a big-endian bit string,
      --  so bit 0 is the most significant bit of X (0).
      --  Bits beyond the end of X are 0.
      function Bit (X : in Byte_Seq; K : in N32) return U32
      is (if K / 8 <= X'Last
          then U32 (Shift_Right (X (K / 8), 7 - Natural (K mod 8)) and 1)
          else 0)
        with Ghost,
             Global => null,
             Pre    => X'First = 0;

      --  Algorithm 2. toInt (X, n), where n = X'Length
      --  The result is the integer whose big-endian representation
      --  is X. X'Length <= 8, so the result always fits in a U64.
      function To_Int (X : in Byte_Seq) return U64
        with Global => null,
             Pre    => X'Length <= 8,
             Post   => (for all I in X'Range =>
                          Byte_Of (To_Int'Result, Natural (X'Last - I)) = X (I)) and
                       (if X'Length < 8 then
                          Shift_Right (To_Int'Result, 8 * X'Length) = 0);

      --  Algorithm 3. toByte (X, n), where n = S'Length
      --  S is the n-byte big-endian representation of X. If n > 8,
      --  the leading n - 8 bytes are zero. If n < 8, the most
      --  significant bytes of X are discarded.
      procedure To_Byte (X : in U64; S : out Byte_Seq)
        with Global => null,
             Pre    => S'Last < I32'Last,
             Post   => (for all I in S'Range =>
                          S (I) = Byte_Of (X, Natural (S'Last - I)));

      subtype Base_2b_Bits is Natural range 1 .. 24;

      --  True if V is the B-bit integer whose big-endian representation
      --  is bits Start .. Start + B - 1 of X
      function Is_Bits_Of (X : in Byte_Seq; V : in U32; B : in Base_2b_Bits; Start : in N32) return Boolean
      is (Shift_Right (V, B) = 0 and then
          (for all J in 0 .. B - 1 =>
             (Shift_Right (V, B - 1 - J) and 1) = Bit (X, Start + I32 (J))))
        with Ghost,
             Global => null,
             Pre    => X'First = 0 and Start <= 2**30;

      --  Algorithm 4. base_2b (X, B, out_len), where out_len = Base_B'Length
      --  Base_B (O) is the integer whose big-endian representation is
      --  bits O * B .. O * B + B - 1 of X.
      --
      --  B <= 24 ensures that the working value Total in Algorithm 4
      --  fits in 32 bits, as noted in FIPS 205 section 4.4
      procedure Base_2b (X : in Byte_Seq; B : in Base_2b_Bits; Base_B : out U32_Seq)
        with Global            => null,
             Always_Terminates => True,
             Pre    => X'First = 0 and then
                       X'Last < 2**24 and then
                       Base_B'First = 0 and then
                       Base_B'Length <= 2**16 and then
                       --  i.e. X'Length >= Ceiling (Base_B'Length * B / 8)
                       8 * X'Length >= Base_B'Length * B,
             Post   => (for all O in Base_B'Range =>
                          Is_Bits_Of (X, Base_B (O), B, O * I32 (B)));
   end Conversions;

   --==============================================
   --  Winternitz One-Time Signature Plus (WOTS+)
   --  See FIPS 205 section 5
   --
   --  All subprograms here are pure functions. In
   --  FIPS 205, chain, wots_pkGen and wots_pkFromSig
   --  change the caller's ADRS (the chain and hash
   --  address words 6 and 7). Every caller of these
   --  functions in FIPS 205 sections 6 to 8 calls
   --  setTypeAndClear on ADRS before using it again,
   --  which clears those words, so those changes are
   --  never observed. Here, A is an "in" parameter,
   --  and each address is a new value computed from A.
   --==============================================

   subtype Index_Len   is N32 range 0 .. Len - 1;

   --  A WOTS+ signature, and the array tmp in Algorithms
   --  6 and 8, are arrays of Len byte strings of N bytes.
   --  See FIPS 205 Figure 10.
   type WOTS_Array is array (Index_Len) of Bytes_N;

   --  The concatenation of the elements of a WOTS_Array
   subtype Index_Len_N is I32 range 0 .. Len * N - 1;
   subtype Bytes_Len_N is Byte_Seq (Index_Len_N);

   --  Integers in base w, which are also the
   --  indices and lengths of hash chains
   subtype Chain_Index is N32 range 0 .. W - 1;

   --  The array msg in Algorithms 7 and 8
   type Base_W_Msg is array (Index_Len) of Chain_Index;

   package WOTS
   is
      --  tmp[0] || tmp[1] || ... || tmp[len - 1], the input to
      --  T_len in Algorithm 6 line 13 and Algorithm 8 line 15
      function Flatten (V : in WOTS_Array) return Bytes_Len_N
        with Global => null,
             Post   => (for all I in Index_Len =>
                          (for all J in Index_N =>
                             Flatten'Result (I * N + J) = V (I) (J)));

      ------------------------------------------------------
      --  Addresses used by WOTS+
      --
      --  Each of these returns a copy of A, modified by
      --  the ADRS setters used in Algorithms 5 to 8
      ------------------------------------------------------

      --  ADRS.setHashAddress (J). Algorithm 5 line 3
      function With_Hash_Address (A : in ADRS_Bytes; J : in U32) return ADRS_Bytes
        with Global => null;

      --  ADRS.setChainAddress (I). Algorithm 6 line 7,
      --  Algorithm 7 line 14 and Algorithm 8 line 9
      function Chain_ADRS (A : in ADRS_Bytes; I : in Index_Len) return ADRS_Bytes
        with Global => null;

      --  skADRS after Algorithm 6 lines 1 to 3 and 5,
      --  and Algorithm 7 lines 8 to 10 and 12:
      --    skADRS <- ADRS
      --    skADRS.setTypeAndClear (WOTS_PRF)
      --    skADRS.setKeyPairAddress (ADRS.getKeyPairAddress ())
      --    skADRS.setChainAddress (I)
      function SK_ADRS (A : in ADRS_Bytes; I : in Index_Len) return ADRS_Bytes
        with Global => null;

      --  wotspkADRS after Algorithm 6 lines 10 to 12
      --  and Algorithm 8 lines 12 to 14:
      --    wotspkADRS <- ADRS
      --    wotspkADRS.setTypeAndClear (WOTS_PK)
      --    wotspkADRS.setKeyPairAddress (ADRS.getKeyPairAddress ())
      --
      --  In FIPS 205, ADRS has had its chain and hash addresses
      --  changed by then, but setTypeAndClear clears them, so
      --  the result is the same as when computed from the
      --  caller's A
      function WOTS_PK_ADRS (A : in ADRS_Bytes) return ADRS_Bytes
        with Global => null;

      ------------------------------------------------------
      --  Algorithm 5. chain (X, i, s, PK.seed, ADRS)
      ------------------------------------------------------

      --  The definition of chain, as a recursive function:
      --    chain (X, i, 0)     = X
      --    chain (X, i, s + 1) = F (PK.seed, ADRS with hash address i + s,
      --                             chain (X, i, s))
      function Chain_Spec (X       : in Bytes_N;
                           I       : in Chain_Index;
                           S       : in Chain_Index;
                           PK_Seed : in Bytes_N;
                           A       : in ADRS_Bytes) return Bytes_N
      is (if S = 0 then X
          else Hash.F (PK_Seed,
                       With_Hash_Address (A, U32 (I + S - 1)),
                       Chain_Spec (X, I, S - 1, PK_Seed, A)))
        with Ghost,
             Global             => null,
             Pre                => I + S <= W - 1,
             Subprogram_Variant => (Decreases => S),
             --  The body is hidden from the provers, except where
             --  Lemma_Chain_Spec is called. This keeps recursive
             --  unfolding of the definition out of other proofs.
             Annotate           => (GNATprove, Hide_Info, "Expression_Function_Body");

      --  The definition of Chain_Spec
      procedure Lemma_Chain_Spec (X       : in Bytes_N;
                                  I       : in Chain_Index;
                                  S       : in Chain_Index;
                                  PK_Seed : in Bytes_N;
                                  A       : in ADRS_Bytes)
        with Ghost,
             Global => null,
             Pre    => I + S <= W - 1,
             Post   => Chain_Spec (X, I, S, PK_Seed, A) =
                         (if S = 0 then X
                          else Hash.F (PK_Seed,
                                       With_Hash_Address (A, U32 (I + S - 1)),
                                       Chain_Spec (X, I, S - 1, PK_Seed, A)));

      --  Algorithm 5. Iterates F S times on X, starting at index I
      function Chain (X       : in Bytes_N;
                      I       : in Chain_Index;
                      S       : in Chain_Index;
                      PK_Seed : in Bytes_N;
                      A       : in ADRS_Bytes) return Bytes_N
        with Global => null,
             Pre    => I + S <= W - 1, --  i + s < w
             Post   => Chain'Result = Chain_Spec (X, I, S, PK_Seed, A);

      --  Chaining S1 steps from I, then S2 steps from I + S1, is the
      --  same as chaining S1 + S2 steps from I
      procedure Lemma_Chain_Compose (X       : in Bytes_N;
                                     I       : in Chain_Index;
                                     S1      : in Chain_Index;
                                     S2      : in Chain_Index;
                                     PK_Seed : in Bytes_N;
                                     A       : in ADRS_Bytes)
        with Ghost,
             Global             => null,
             Pre                => I + S1 + S2 <= W - 1,
             Post               =>
               Chain_Spec (Chain_Spec (X, I, S1, PK_Seed, A), I + S1, S2, PK_Seed, A) =
                 Chain_Spec (X, I, S1 + S2, PK_Seed, A),
             Subprogram_Variant => (Decreases => S2);

      ------------------------------------------------------
      --  Algorithms 7 and 8, lines 1 to 7
      --
      --  M in base w, followed by its checksum in base w.
      --  This is msg after line 7 of Algorithms 7 and 8.
      ------------------------------------------------------
      function Msg_With_Checksum (M : in Bytes_N) return Base_W_Msg
        with Global => null;

      ------------------------------------------------------
      --  Algorithm 6. wots_pkGen (SK.seed, PK.seed, ADRS)
      ------------------------------------------------------

      --  Algorithm 6 lines 1 to 9: the array tmp of public values
      function PK_Gen_Values (SK_Seed : in Bytes_N;
                              PK_Seed : in Bytes_N;
                              A       : in ADRS_Bytes) return WOTS_Array
        with Global => null,
             Post   =>
               (for all I in Index_Len =>
                  PK_Gen_Values'Result (I) =
                    Chain_Spec (Hash.PRF (PK_Seed, SK_Seed, SK_ADRS (A, I)),
                                0, W - 1, PK_Seed, Chain_ADRS (A, I)));

      function Wots_PK_Gen (SK_Seed : in Bytes_N;
                            PK_Seed : in Bytes_N;
                            A       : in ADRS_Bytes) return Bytes_N
        with Global => null,
             Post   => Wots_PK_Gen'Result =
                         Hash.T_L (PK_Seed, WOTS_PK_ADRS (A),
                                   Flatten (PK_Gen_Values (SK_Seed, PK_Seed, A)));

      ------------------------------------------------------
      --  Algorithm 7. wots_sign (M, SK.seed, PK.seed, ADRS)
      ------------------------------------------------------
      function Wots_Sign (M       : in Bytes_N;
                          SK_Seed : in Bytes_N;
                          PK_Seed : in Bytes_N;
                          A       : in ADRS_Bytes) return WOTS_Array
        with Global => null,
             Post   =>
               (for all I in Index_Len =>
                  Wots_Sign'Result (I) =
                    Chain_Spec (Hash.PRF (PK_Seed, SK_Seed, SK_ADRS (A, I)),
                                0, Msg_With_Checksum (M) (I),
                                PK_Seed, Chain_ADRS (A, I)));

      ------------------------------------------------------
      --  Algorithm 8. wots_pkFromSig (sig, M, PK.seed, ADRS)
      ------------------------------------------------------

      --  Algorithm 8 lines 1 to 11: the array tmp of public values
      function PK_From_Sig_Values (Sig     : in WOTS_Array;
                                   M       : in Bytes_N;
                                   PK_Seed : in Bytes_N;
                                   A       : in ADRS_Bytes) return WOTS_Array
        with Global => null,
             Post   =>
               (for all I in Index_Len =>
                  PK_From_Sig_Values'Result (I) =
                    Chain_Spec (Sig (I),
                                Msg_With_Checksum (M) (I),
                                W - 1 - Msg_With_Checksum (M) (I),
                                PK_Seed, Chain_ADRS (A, I)));

      function Wots_PK_From_Sig (Sig     : in WOTS_Array;
                                 M       : in Bytes_N;
                                 PK_Seed : in Bytes_N;
                                 A       : in ADRS_Bytes) return Bytes_N
        with Global => null,
             Post   => Wots_PK_From_Sig'Result =
                         Hash.T_L (PK_Seed, WOTS_PK_ADRS (A),
                                   Flatten (PK_From_Sig_Values (Sig, M, PK_Seed, A)));

      ------------------------------------------------------
      --  Correctness of WOTS+
      --
      --  The public key computed from a valid signature of M
      --  is the public key generated by wots_pkGen
      ------------------------------------------------------
      procedure Theorem_Round_Trip (M       : in Bytes_N;
                                    SK_Seed : in Bytes_N;
                                    PK_Seed : in Bytes_N;
                                    A       : in ADRS_Bytes)
        with Ghost,
             Global => null,
             Post   => Wots_PK_From_Sig (Wots_Sign (M, SK_Seed, PK_Seed, A), M, PK_Seed, A) =
                         Wots_PK_Gen (SK_Seed, PK_Seed, A);
   end WOTS;

   --==============================================
   --  eXtended Merkle Signature Scheme (XMSS)
   --  See FIPS 205 section 6
   --
   --  As for WOTS, all subprograms here are pure
   --  functions, and A is an "in" parameter. In
   --  FIPS 205, Algorithms 9 to 11 change words 4
   --  to 7 of the caller's ADRS, but each use of
   --  ADRS is preceded by setTypeAndClear, which
   --  sets word 4 and clears words 5 to 7, and
   --  words 0 to 3 (the layer and tree addresses)
   --  are never changed, so those changes are
   --  never observed.
   --==============================================

   --  Heights of nodes in an XMSS tree. Leaves have height 0,
   --  and the root has height H_Tick
   subtype Tree_Height is N32 range 0 .. H_Tick;

   --  Indices of nodes within one level of an XMSS tree. A node
   --  of height Z has an index less than 2**(H_Tick - Z).
   --  The index of a leaf is the index of its WOTS+ key (idx).
   --
   --  These are U32, since FIPS 205 uses bit operations on them,
   --  and they are written to ADRS as 32-bit words
   subtype Node_Index is U32 range 0 .. 2**H_Tick - 1;

   --  AUTH, the authentication path in an XMSS signature
   subtype Auth_Index is N32 range 0 .. H_Tick - 1;
   type Auth_Path is array (Auth_Index) of Bytes_N;

   --  An XMSS signature, SIG_XMSS = sig || AUTH.
   --  See FIPS 205 Figure 11.
   type XMSS_Sig is record
      Sig  : WOTS_Array;
      Auth : Auth_Path;
   end record;

   package XMSS
   is
      --  L || R
      --
      --  This is not an expression function, since inlining one
      --  with -O2 -gnatn crashes GNAT 16.1 ("GNAT BUG DETECTED ...
      --  in process_freeze_entity, at ada/gcc-interface/trans.cc")
      function Concat (L, R : in Bytes_N) return Bytes_2N
        with Global => null,
             Post   => Concat'Result = L & R;

      --  True if I is the index of a node of height Z,
      --  that is, if I < 2**(H_Tick - Z)
      function Valid_Node (I : in Node_Index; Z : in Tree_Height) return Boolean
      is (Shift_Right (I, Natural (H_Tick - Z)) = 0)
        with Global => null;

      ------------------------------------------------------
      --  Addresses used by XMSS
      ------------------------------------------------------

      --  ADRS after Algorithm 9 lines 2 and 3,
      --  Algorithm 10 lines 5 and 6, and Algorithm 11 lines 1 and 2:
      --    ADRS.setTypeAndClear (WOTS_HASH)
      --    ADRS.setKeyPairAddress (I)
      function Leaf_ADRS (A : in ADRS_Bytes; I : in Node_Index) return ADRS_Bytes
        with Global => null;

      --  ADRS after Algorithm 9 lines 8 to 10, and after
      --  Algorithm 11 lines 9 and 11 or 14:
      --    ADRS.setTypeAndClear (TREE)
      --    ADRS.setTreeHeight (Z)
      --    ADRS.setTreeIndex (I)
      --
      --  In Algorithm 11, ADRS is set up by setTypeAndClear (TREE)
      --  in line 6, and then every iteration of the loop sets both
      --  the tree height and tree index, so ADRS in lines 12 and 15
      --  is the same as this function's result.
      function Tree_ADRS (A : in ADRS_Bytes; Z : in Tree_Height; I : in Node_Index) return ADRS_Bytes
        with Global => null;

      ------------------------------------------------------
      --  Algorithm 9. xmss_node (SK.seed, i, z, PK.seed, ADRS)
      --
      --  The root of the subtree of height Z whose root has
      --  index I. Recursive, as in FIPS 205.
      ------------------------------------------------------
      function XMSS_Node (SK_Seed : in Bytes_N;
                          I       : in Node_Index;
                          Z       : in Tree_Height;
                          PK_Seed : in Bytes_N;
                          A       : in ADRS_Bytes) return Bytes_N
      is (if Z = 0
          then                                                    --  Line 1
            WOTS.Wots_PK_Gen (SK_Seed, PK_Seed, Leaf_ADRS (A, I)) --  Lines 2 to 4
          else
            Hash.H (PK_Seed,
                    Tree_ADRS (A, Z, I),                          --  Lines 8 to 10
                    Concat (XMSS_Node (SK_Seed, 2 * I, Z - 1, PK_Seed, A),       --  Line 6, lnode
                            XMSS_Node (SK_Seed, 2 * I + 1, Z - 1, PK_Seed, A)))) --  Line 7, rnode
        with Global             => null,
             Pre                => Valid_Node (I, Z),
             Subprogram_Variant => (Decreases => Z),
             --  The body is hidden from the provers, except where
             --  Lemma_XMSS_Node is called
             Annotate           => (GNATprove, Hide_Info, "Expression_Function_Body");

      --  The definition of XMSS_Node
      procedure Lemma_XMSS_Node (SK_Seed : in Bytes_N;
                                 I       : in Node_Index;
                                 Z       : in Tree_Height;
                                 PK_Seed : in Bytes_N;
                                 A       : in ADRS_Bytes)
        with Ghost,
             Global => null,
             Pre    => Valid_Node (I, Z),
             Post   => XMSS_Node (SK_Seed, I, Z, PK_Seed, A) =
                         (if Z = 0
                          then WOTS.Wots_PK_Gen (SK_Seed, PK_Seed, Leaf_ADRS (A, I))
                          else Hash.H (PK_Seed,
                                       Tree_ADRS (A, Z, I),
                                       Concat (XMSS_Node (SK_Seed, 2 * I, Z - 1, PK_Seed, A),
                                               XMSS_Node (SK_Seed, 2 * I + 1, Z - 1, PK_Seed, A))));

      ------------------------------------------------------
      --  Algorithm 10. xmss_sign (M, SK.seed, idx, PK.seed, ADRS)
      ------------------------------------------------------

      --  Algorithm 10 line 2. k <- Floor (idx / 2**j) xor 1, the index
      --  of the sibling of the node of height J on the path from leaf
      --  Idx to the root
      function Sibling (Idx : in Node_Index; J : in Auth_Index) return Node_Index
      is (Shift_Right (Idx, Natural (J)) xor 1)
        with Global => null;

      function XMSS_Sign (M       : in Bytes_N;
                          SK_Seed : in Bytes_N;
                          Idx     : in Node_Index;
                          PK_Seed : in Bytes_N;
                          A       : in ADRS_Bytes) return XMSS_Sig
        with Global => null,
             Post   =>
               XMSS_Sign'Result.Sig = WOTS.Wots_Sign (M, SK_Seed, PK_Seed, Leaf_ADRS (A, Idx)) and
               (for all J in Auth_Index =>
                  XMSS_Sign'Result.Auth (J) =
                    XMSS_Node (SK_Seed, Sibling (Idx, J), J, PK_Seed, A));

      ------------------------------------------------------
      --  Algorithm 11. xmss_pkFromSig (idx, SIG_XMSS, M, PK.seed, ADRS)
      ------------------------------------------------------

      --  The node of height K on the path from leaf Idx to the root,
      --  computed from the value Leaf of leaf Idx, and the
      --  authentication path Auth, as in Algorithm 11 lines 8 to 18:
      --    Path_Node (0)     = Leaf
      --    Path_Node (K + 1) = H (PK.seed, ADRS, Path_Node (K) || Auth (K))
      --                          if Floor (Idx / 2**K) is even, or
      --                        H (PK.seed, ADRS, Auth (K) || Path_Node (K))
      --                          otherwise,
      --  where ADRS has tree height K + 1 and tree index
      --  Floor (Idx / 2**(K + 1)).
      function Path_Node (Leaf    : in Bytes_N;
                          Idx     : in Node_Index;
                          Auth    : in Auth_Path;
                          K       : in Tree_Height;
                          PK_Seed : in Bytes_N;
                          A       : in ADRS_Bytes) return Bytes_N
      is (if K = 0 then Leaf
          else Hash.H (PK_Seed,
                       Tree_ADRS (A, K, Shift_Right (Idx, Natural (K))),
                       (if (Shift_Right (Idx, Natural (K - 1)) and 1) = 0
                        then Concat (Path_Node (Leaf, Idx, Auth, K - 1, PK_Seed, A), Auth (K - 1))
                        else Concat (Auth (K - 1), Path_Node (Leaf, Idx, Auth, K - 1, PK_Seed, A)))))
        with Ghost,
             Global             => null,
             Subprogram_Variant => (Decreases => K),
             Annotate           => (GNATprove, Hide_Info, "Expression_Function_Body");

      --  The definition of Path_Node
      procedure Lemma_Path_Node (Leaf    : in Bytes_N;
                                 Idx     : in Node_Index;
                                 Auth    : in Auth_Path;
                                 K       : in Tree_Height;
                                 PK_Seed : in Bytes_N;
                                 A       : in ADRS_Bytes)
        with Ghost,
             Global => null,
             Post   =>
               Path_Node (Leaf, Idx, Auth, K, PK_Seed, A) =
                 (if K = 0 then Leaf
                  else Hash.H (PK_Seed,
                               Tree_ADRS (A, K, Shift_Right (Idx, Natural (K))),
                               (if (Shift_Right (Idx, Natural (K - 1)) and 1) = 0
                                then Concat (Path_Node (Leaf, Idx, Auth, K - 1, PK_Seed, A), Auth (K - 1))
                                else Concat (Auth (K - 1), Path_Node (Leaf, Idx, Auth, K - 1, PK_Seed, A)))));

      function XMSS_PK_From_Sig (Idx     : in Node_Index;
                                 S       : in XMSS_Sig;
                                 M       : in Bytes_N;
                                 PK_Seed : in Bytes_N;
                                 A       : in ADRS_Bytes) return Bytes_N
        with Global => null,
             Post   =>
               XMSS_PK_From_Sig'Result =
                 Path_Node (WOTS.Wots_PK_From_Sig (S.Sig, M, PK_Seed, Leaf_ADRS (A, Idx)),
                            Idx, S.Auth, H_Tick, PK_Seed, A);

      ------------------------------------------------------
      --  Correctness of XMSS
      --
      --  The root computed from a valid signature of M is the
      --  root of the XMSS tree, that is, the XMSS public key
      ------------------------------------------------------
      procedure Theorem_Round_Trip (M       : in Bytes_N;
                                    SK_Seed : in Bytes_N;
                                    Idx     : in Node_Index;
                                    PK_Seed : in Bytes_N;
                                    A       : in ADRS_Bytes)
        with Ghost,
             Global => null,
             Post   => XMSS_PK_From_Sig (Idx, XMSS_Sign (M, SK_Seed, Idx, PK_Seed, A), M, PK_Seed, A) =
                         XMSS_Node (SK_Seed, 0, H_Tick, PK_Seed, A);
   end XMSS;

   --==============================================
   --  The SLH-DSA Hypertree (HT)
   --  See FIPS 205 section 7
   --
   --  As for WOTS and XMSS, all subprograms here
   --  are pure functions. In FIPS 205, Algorithms
   --  12 and 13 reuse one ADRS for every layer, and
   --  only set its layer and tree addresses (words
   --  0 to 3) between layers. Here, each layer gets
   --  a new ADRS with only those words set, from
   --  Layer_ADRS. The XMSS functions do not change
   --  their ADRS, so in this implementation words
   --  4 to 7 are always zero; and in FIPS 205, the
   --  XMSS functions only use words 4 to 7 after
   --  setTypeAndClear, so their values between
   --  layers are never observed.
   --==============================================

   --  Layers of the hypertree. Layer 0 is the lowest,
   --  and layer D - 1 is the single tree at the top
   subtype Layer_Index is N32 range 0 .. D - 1;

   --  idx_tree, the index of an XMSS tree in the lowest layer.
   --  There are 2**(H - H_Tick) trees in that layer
   subtype Tree_Index is U64 range 0 .. 2**(H - H_Tick) - 1;

   --  SIG_HT, a hypertree signature: one XMSS signature
   --  for each layer, starting with layer 0. See FIPS 205
   --  Figure 13.
   type HT_Sig is array (Layer_Index) of XMSS_Sig;

   package HT
   is
      ------------------------------------------------------
      --  Indices and addresses for each layer
      ------------------------------------------------------

      --  idx_tree at layer J. Algorithm 12 line 8 and
      --  Algorithm 13 line 7 remove the H_Tick least
      --  significant bits of idx_tree for each layer
      function Tree_At (Idx_Tree : in Tree_Index; J : in Layer_Index) return Tree_Index
      is (Shift_Right (Idx_Tree, Natural (J) * H_Tick))
        with Global => null;

      --  idx_leaf at layer J. At layer 0 this is Idx_Leaf.
      --  Algorithm 12 line 7 and Algorithm 13 line 6 take it
      --  from the H_Tick least significant bits of idx_tree at
      --  the layer below
      function Leaf_At (Idx_Tree : in Tree_Index;
                        Idx_Leaf : in Node_Index;
                        J        : in Layer_Index) return Node_Index
      is (if J = 0 then Idx_Leaf
          else Node_Index (Tree_At (Idx_Tree, J - 1) and (2**H_Tick - 1)))
        with Global => null;

      --  ADRS after Algorithm 12 lines 1 and 2, or lines 9 and 10,
      --  and after Algorithm 13 lines 1 and 2, or lines 8 and 9:
      --    ADRS <- toByte (0, 32)
      --    ADRS.setLayerAddress (J)
      --    ADRS.setTreeAddress (T)
      function Layer_ADRS (J : in Layer_Index; T : in Tree_Index) return ADRS_Bytes
        with Global => null;

      --  The XMSS public key (root) of the XMSS tree used at layer J
      function Layer_Root (SK_Seed  : in Bytes_N;
                           PK_Seed  : in Bytes_N;
                           Idx_Tree : in Tree_Index;
                           J        : in Layer_Index) return Bytes_N
      is (XMSS.XMSS_Node (SK_Seed, 0, H_Tick, PK_Seed, Layer_ADRS (J, Tree_At (Idx_Tree, J))))
        with Ghost,
             Global => null;

      --  The message signed at layer J: M at layer 0, and the
      --  root of the XMSS tree at layer J - 1 at every other layer
      --
      function Layer_Msg (M        : in Bytes_N;
                          SK_Seed  : in Bytes_N;
                          PK_Seed  : in Bytes_N;
                          Idx_Tree : in Tree_Index;
                          J        : in Layer_Index) return Bytes_N
      is (if J = 0 then M else Layer_Root (SK_Seed, PK_Seed, Idx_Tree, J - 1))
        with Ghost,
             Global => null;

      ------------------------------------------------------
      --  Algorithm 12. ht_sign (M, SK.seed, PK.seed, idx_tree, idx_leaf)
      --
      --  Layer J of the result is the XMSS signature of
      --  Layer_Msg (J) with the XMSS key of the tree at layer J.
      --  The body computes each Layer_Msg with xmss_pkFromSig,
      --  as in lines 5 and 14, and the postcondition follows
      --  from the XMSS round trip theorem.
      ------------------------------------------------------
      function HT_Sign (M        : in Bytes_N;
                        SK_Seed  : in Bytes_N;
                        PK_Seed  : in Bytes_N;
                        Idx_Tree : in Tree_Index;
                        Idx_Leaf : in Node_Index) return HT_Sig
        with Global => null,
             Post   =>
               (for all J in Layer_Index =>
                  HT_Sign'Result (J) =
                    XMSS.XMSS_Sign (Layer_Msg (M, SK_Seed, PK_Seed, Idx_Tree, J),
                                    SK_Seed,
                                    Leaf_At (Idx_Tree, Idx_Leaf, J),
                                    PK_Seed,
                                    Layer_ADRS (J, Tree_At (Idx_Tree, J))));

      ------------------------------------------------------
      --  Algorithm 13. ht_verify (M, SIG_HT, PK.seed, idx_tree,
      --                           idx_leaf, PK.root)
      ------------------------------------------------------

      --  The XMSS public key computed from layer J of S and the
      --  message X, as in Algorithm 13 lines 4 and 11
      --
      --  This is not an expression function, and Verify_Node calls it
      --  instead of calling XMSS_PK_From_Sig itself, since an
      --  expression function that calls XMSS_PK_From_Sig with an
      --  ADRS computed by Layer_ADRS crashes GNAT 16.1 ("GNAT BUG
      --  DETECTED ... Constraint_Error erroneous memory access")
      function Layer_PK (X        : in Bytes_N;
                         S        : in HT_Sig;
                         PK_Seed  : in Bytes_N;
                         Idx_Tree : in Tree_Index;
                         Idx_Leaf : in Node_Index;
                         J        : in Layer_Index) return Bytes_N
        with Global => null,
             Post   => Layer_PK'Result =
                         XMSS.XMSS_PK_From_Sig (Leaf_At (Idx_Tree, Idx_Leaf, J),
                                                S (J),
                                                X,
                                                PK_Seed,
                                                Layer_ADRS (J, Tree_At (Idx_Tree, J)));

      --  The node computed at layer J, as in Algorithm 13 lines 4
      --  and 11: the XMSS public key computed from layer J of S
      --  and the message signed at that layer, which is M at
      --  layer 0, and the node computed at layer J - 1 otherwise
      function Verify_Node (M        : in Bytes_N;
                            S        : in HT_Sig;
                            PK_Seed  : in Bytes_N;
                            Idx_Tree : in Tree_Index;
                            Idx_Leaf : in Node_Index;
                            J        : in Layer_Index) return Bytes_N
      is (Layer_PK ((if J = 0 then M else Verify_Node (M, S, PK_Seed, Idx_Tree, Idx_Leaf, J - 1)),
                    S, PK_Seed, Idx_Tree, Idx_Leaf, J))
        with Ghost,
             Global             => null,
             Subprogram_Variant => (Decreases => J),
             Annotate           => (GNATprove, Hide_Info, "Expression_Function_Body");

      --  The definition of Verify_Node
      procedure Lemma_Verify_Node (M        : in Bytes_N;
                                   S        : in HT_Sig;
                                   PK_Seed  : in Bytes_N;
                                   Idx_Tree : in Tree_Index;
                                   Idx_Leaf : in Node_Index;
                                   J        : in Layer_Index)
        with Ghost,
             Global => null,
             Post   =>
               Verify_Node (M, S, PK_Seed, Idx_Tree, Idx_Leaf, J) =
                 Layer_PK ((if J = 0 then M else Verify_Node (M, S, PK_Seed, Idx_Tree, Idx_Leaf, J - 1)),
                           S, PK_Seed, Idx_Tree, Idx_Leaf, J);

      function HT_Verify (M        : in Bytes_N;
                          S        : in HT_Sig;
                          PK_Seed  : in Bytes_N;
                          Idx_Tree : in Tree_Index;
                          Idx_Leaf : in Node_Index;
                          PK_Root  : in Bytes_N) return Boolean
        with Global => null,
             Post   =>
               HT_Verify'Result =
                 (Verify_Node (M, S, PK_Seed, Idx_Tree, Idx_Leaf, D - 1) = PK_Root);

      ------------------------------------------------------
      --  Correctness of the hypertree
      --
      --  A hypertree signature of M verifies against the root
      --  of the single XMSS tree at the top layer, which is the
      --  hypertree public key PK.root
      ------------------------------------------------------
      procedure Theorem_Round_Trip (M        : in Bytes_N;
                                    SK_Seed  : in Bytes_N;
                                    PK_Seed  : in Bytes_N;
                                    Idx_Tree : in Tree_Index;
                                    Idx_Leaf : in Node_Index)
        with Ghost,
             Global => null,
             Post   =>
               HT_Verify (M,
                          HT_Sign (M, SK_Seed, PK_Seed, Idx_Tree, Idx_Leaf),
                          PK_Seed,
                          Idx_Tree,
                          Idx_Leaf,
                          XMSS.XMSS_Node (SK_Seed, 0, H_Tick, PK_Seed, Layer_ADRS (D - 1, 0)));
   end HT;

   --==============================================
   --  Forest of Random Subsets (FORS)
   --  See FIPS 205 section 8
   --
   --  As for WOTS, XMSS and HT, all subprograms
   --  here are pure functions, and the address is
   --  an "in" parameter. It is named Adr here,
   --  since A is the FORS tree height.
   --
   --  Unlike XMSS, FIPS 205 Algorithms 15 and 17 do
   --  not call setTypeAndClear on the caller's ADRS.
   --  They only change words 6 and 7 (tree height
   --  and tree index), and they set both of those
   --  words before each use of ADRS in a hash, so
   --  their earlier values are never observed.
   --  Algorithms 14 and 17 copy ADRS before calling
   --  setTypeAndClear. So each address here is the
   --  caller's Adr with some words replaced.
   --
   --  FIPS 205 requires the caller's ADRS to have
   --  layer address 0 and type FORS_TREE, with the
   --  tree and key pair addresses of the signing
   --  WOTS+ key. The algorithms don't depend on
   --  this, so it is not a precondition here.
   --==============================================

   --  md, the message digest signed by FORS: Ceiling (k * a / 8) bytes,
   --  of which the first k * a bits are used
   MD_Bytes : constant := (K * A + 7) / 8;
   subtype Index_MD is N32 range 0 .. MD_Bytes - 1;
   subtype Bytes_MD is Byte_Seq (Index_MD);

   --  The K FORS trees, each of height A, with 2**A leaves
   subtype FORS_Tree_Index is N32 range 0 .. K - 1;

   --  indices[i] from Algorithms 16 and 17: a leaf of one tree
   subtype FORS_Leaf is U32 range 0 .. 2**A - 1;
   type FORS_Indices is array (FORS_Tree_Index) of FORS_Leaf;

   --  Heights of nodes in a FORS tree
   subtype FORS_Height is N32 range 0 .. A;

   --  Indices of nodes. FIPS 205 numbers the nodes of each height
   --  across all K trees, so a node of height Z in tree I has an
   --  index in I * 2**(A - Z) .. (I + 1) * 2**(A - Z) - 1
   subtype FORS_Node_Index is U32 range 0 .. K * 2**A - 1;

   --  AUTH for one FORS tree
   subtype FORS_Auth_Index is N32 range 0 .. A - 1;
   type FORS_Auth is array (FORS_Auth_Index) of Bytes_N;

   --  One private key value and its AUTH, for one tree
   type FORS_Elem is record
      SK   : Bytes_N;
      Auth : FORS_Auth;
   end record;

   --  SIG_FORS. See FIPS 205 Figure 14
   type FORS_Sig is array (FORS_Tree_Index) of FORS_Elem;

   --  root in Algorithm 17, the roots of the K trees
   type FORS_Roots is array (FORS_Tree_Index) of Bytes_N;

   subtype Index_K_N is I32 range 0 .. K * N - 1;
   subtype Bytes_K_N is Byte_Seq (Index_K_N);

   package FORS
   is
      --  root[0] || root[1] || ... || root[k - 1], the input to
      --  T_k in Algorithm 17 line 24
      function Flatten (R : in FORS_Roots) return Bytes_K_N
        with Global => null,
             Post   => (for all I in FORS_Tree_Index =>
                          (for all J in Index_N =>
                             Flatten'Result (I * N + J) = R (I) (J)));

      --  True if I is the index of a node of height Z,
      --  that is, if I < K * 2**(A - Z)
      function Valid_Node (I : in FORS_Node_Index; Z : in FORS_Height) return Boolean
      is (Shift_Right (I, Natural (A - Z)) < K)
        with Global => null;

      --  i * 2**a + indices[i], the index of leaf Idx of tree I
      --  (Algorithm 16 line 4 and Algorithm 17 line 5). Since
      --  Idx < 2**a, this is a shift and an or
      function Leaf_Index (I : in FORS_Tree_Index; Idx : in FORS_Leaf) return FORS_Node_Index
      is (Shift_Left (U32 (I), A) or Idx)
        with Global => null,
             Post   => Valid_Node (Leaf_Index'Result, 0) and
                       Shift_Right (Leaf_Index'Result, A) = U32 (I);

      --  The index of the sibling of the node of height J on the
      --  path from leaf G to the root of its tree. This is
      --  i * 2**(a - j) + s in Algorithm 16 lines 6 and 7, where
      --  G = i * 2**a + indices[i] and s = Floor (indices[i] / 2**j) xor 1.
      --  It is in the same tree as G
      function Sibling (G : in FORS_Node_Index; J : in FORS_Auth_Index) return FORS_Node_Index
      is (Shift_Right (G, Natural (J)) xor 1)
        with Global => null,
             Pre    => Valid_Node (G, 0),
             Post   => Valid_Node (Sibling'Result, J);

      ------------------------------------------------------
      --  Addresses used by FORS
      ------------------------------------------------------

      --  skADRS in Algorithm 14 lines 1 to 4:
      --    skADRS <- ADRS
      --    skADRS.setTypeAndClear (FORS_PRF)
      --    skADRS.setKeyPairAddress (ADRS.getKeyPairAddress ())
      --    skADRS.setTreeIndex (Idx)
      function SK_ADRS (Adr : in ADRS_Bytes; Idx : in FORS_Node_Index) return ADRS_Bytes
        with Global => null;

      --  ADRS after Algorithm 15 lines 3 and 4, or lines 9 and 10,
      --  and after Algorithm 17 lines 4 and 5, or lines 9 and 11 or 14:
      --    ADRS.setTreeHeight (Z)
      --    ADRS.setTreeIndex (I)
      function Node_ADRS (Adr : in ADRS_Bytes; Z : in FORS_Height; I : in FORS_Node_Index)
                          return ADRS_Bytes
        with Global => null;

      --  forspkADRS in Algorithm 17 lines 21 to 23:
      --    forspkADRS <- ADRS
      --    forspkADRS.setTypeAndClear (FORS_ROOTS)
      --    forspkADRS.setKeyPairAddress (ADRS.getKeyPairAddress ())
      function Roots_ADRS (Adr : in ADRS_Bytes) return ADRS_Bytes
        with Global => null;

      ------------------------------------------------------
      --  Algorithm 14. fors_skGen (SK.seed, PK.seed, ADRS, idx)
      ------------------------------------------------------
      function FORS_SK_Gen (SK_Seed : in Bytes_N;
                            PK_Seed : in Bytes_N;
                            Adr     : in ADRS_Bytes;
                            Idx     : in FORS_Node_Index) return Bytes_N
      is (Hash.PRF (PK_Seed, SK_Seed, SK_ADRS (Adr, Idx)))  --  Line 5
        with Global => null;

      ------------------------------------------------------
      --  Algorithm 15. fors_node (SK.seed, i, z, PK.seed, ADRS)
      --
      --  The root of the subtree of height Z whose root has
      --  index I. Recursive, as in FIPS 205.
      ------------------------------------------------------
      function FORS_Node (SK_Seed : in Bytes_N;
                          I       : in FORS_Node_Index;
                          Z       : in FORS_Height;
                          PK_Seed : in Bytes_N;
                          Adr     : in ADRS_Bytes) return Bytes_N
      is (if Z = 0
          then                                                       --  Line 1
            Hash.F (PK_Seed,
                    Node_ADRS (Adr, 0, I),                           --  Lines 3 and 4
                    FORS_SK_Gen (SK_Seed, PK_Seed, Adr, I))          --  Lines 2 and 5
          else
            Hash.H (PK_Seed,
                    Node_ADRS (Adr, Z, I),                           --  Lines 9 and 10
                    XMSS.Concat
                      (FORS_Node (SK_Seed, 2 * I, Z - 1, PK_Seed, Adr),        --  Line 7, lnode
                       FORS_Node (SK_Seed, 2 * I + 1, Z - 1, PK_Seed, Adr))))  --  Line 8, rnode
        with Global             => null,
             Pre                => Valid_Node (I, Z),
             Subprogram_Variant => (Decreases => Z),
             --  The body is hidden from the provers, except where
             --  Lemma_FORS_Node is called
             Annotate           => (GNATprove, Hide_Info, "Expression_Function_Body");

      --  The definition of FORS_Node
      procedure Lemma_FORS_Node (SK_Seed : in Bytes_N;
                                 I       : in FORS_Node_Index;
                                 Z       : in FORS_Height;
                                 PK_Seed : in Bytes_N;
                                 Adr     : in ADRS_Bytes)
        with Ghost,
             Global => null,
             Pre    => Valid_Node (I, Z),
             Post   => FORS_Node (SK_Seed, I, Z, PK_Seed, Adr) =
                         (if Z = 0
                          then Hash.F (PK_Seed, Node_ADRS (Adr, 0, I),
                                       FORS_SK_Gen (SK_Seed, PK_Seed, Adr, I))
                          else Hash.H (PK_Seed,
                                       Node_ADRS (Adr, Z, I),
                                       XMSS.Concat (FORS_Node (SK_Seed, 2 * I, Z - 1, PK_Seed, Adr),
                                                    FORS_Node (SK_Seed, 2 * I + 1, Z - 1, PK_Seed, Adr))));

      ------------------------------------------------------
      --  Algorithm 16. fors_sign (md, SK.seed, PK.seed, ADRS)
      ------------------------------------------------------

      --  indices <- base_2b (md, a, k), Algorithm 16 line 2
      --  and Algorithm 17 line 1
      function Msg_Indices (MD : in Bytes_MD) return FORS_Indices
        with Global => null;

      function FORS_Sign (MD      : in Bytes_MD;
                          SK_Seed : in Bytes_N;
                          PK_Seed : in Bytes_N;
                          Adr     : in ADRS_Bytes) return FORS_Sig
        with Global => null,
             Post   =>
               (for all I in FORS_Tree_Index =>
                  FORS_Sign'Result (I).SK =
                    FORS_SK_Gen (SK_Seed, PK_Seed, Adr, Leaf_Index (I, Msg_Indices (MD) (I))) and
                  (for all J in FORS_Auth_Index =>
                     FORS_Sign'Result (I).Auth (J) =
                       FORS_Node (SK_Seed, Sibling (Leaf_Index (I, Msg_Indices (MD) (I)), J), J,
                                  PK_Seed, Adr)));

      ------------------------------------------------------
      --  Algorithm 17. fors_pkFromSig (SIG_FORS, md, PK.seed, ADRS)
      ------------------------------------------------------

      --  The node of height Z on the path from leaf G to the root of
      --  its tree, computed from the value Leaf of leaf G and the
      --  authentication path Auth, as in Algorithm 17 lines 8 to 18:
      --    Path_Node (0)     = Leaf
      --    Path_Node (Z + 1) = H (PK.seed, ADRS, Path_Node (Z) || Auth (Z))
      --                          if Floor (G / 2**Z) is even, or
      --                        H (PK.seed, ADRS, Auth (Z) || Path_Node (Z))
      --                          otherwise,
      --  where ADRS has tree height Z + 1 and tree index
      --  Floor (G / 2**(Z + 1)).
      --
      --  Floor (G / 2**Z) and Floor (indices[i] / 2**Z) (Algorithm 17
      --  line 10) have the same parity, since Z < A
      function Path_Node (Leaf    : in Bytes_N;
                          G       : in FORS_Node_Index;
                          Auth    : in FORS_Auth;
                          Z       : in FORS_Height;
                          PK_Seed : in Bytes_N;
                          Adr     : in ADRS_Bytes) return Bytes_N
      is (if Z = 0 then Leaf
          else Hash.H (PK_Seed,
                       Node_ADRS (Adr, Z, Shift_Right (G, Natural (Z))),
                       (if (Shift_Right (G, Natural (Z - 1)) and 1) = 0
                        then XMSS.Concat (Path_Node (Leaf, G, Auth, Z - 1, PK_Seed, Adr), Auth (Z - 1))
                        else XMSS.Concat (Auth (Z - 1), Path_Node (Leaf, G, Auth, Z - 1, PK_Seed, Adr)))))
        with Ghost,
             Global             => null,
             Subprogram_Variant => (Decreases => Z),
             Annotate           => (GNATprove, Hide_Info, "Expression_Function_Body");

      --  The definition of Path_Node
      procedure Lemma_Path_Node (Leaf    : in Bytes_N;
                                 G       : in FORS_Node_Index;
                                 Auth    : in FORS_Auth;
                                 Z       : in FORS_Height;
                                 PK_Seed : in Bytes_N;
                                 Adr     : in ADRS_Bytes)
        with Ghost,
             Global => null,
             Post   =>
               Path_Node (Leaf, G, Auth, Z, PK_Seed, Adr) =
                 (if Z = 0 then Leaf
                  else Hash.H (PK_Seed,
                               Node_ADRS (Adr, Z, Shift_Right (G, Natural (Z))),
                               (if (Shift_Right (G, Natural (Z - 1)) and 1) = 0
                                then XMSS.Concat (Path_Node (Leaf, G, Auth, Z - 1, PK_Seed, Adr),
                                                  Auth (Z - 1))
                                else XMSS.Concat (Auth (Z - 1),
                                                  Path_Node (Leaf, G, Auth, Z - 1, PK_Seed, Adr)))));

      --  The root of tree I computed from element S of a signature,
      --  for leaf G of that tree: lines 3 to 19 of Algorithm 17
      function Tree_Root_From_Sig (S       : in FORS_Elem;
                                   G       : in FORS_Node_Index;
                                   PK_Seed : in Bytes_N;
                                   Adr     : in ADRS_Bytes) return Bytes_N
      is (Path_Node (Hash.F (PK_Seed, Node_ADRS (Adr, 0, G), S.SK),  --  Lines 4 to 6
                     G, S.Auth, A, PK_Seed, Adr))
        with Ghost,
             Global => null;

      --  The roots computed from S, root in Algorithm 17 line 20
      function Roots_From_Sig (S       : in FORS_Sig;
                               MD      : in Bytes_MD;
                               PK_Seed : in Bytes_N;
                               Adr     : in ADRS_Bytes) return FORS_Roots
        with Ghost,
             Global => null,
             Post   =>
               (for all I in FORS_Tree_Index =>
                  Roots_From_Sig'Result (I) =
                    Tree_Root_From_Sig (S (I), Leaf_Index (I, Msg_Indices (MD) (I)), PK_Seed, Adr));

      function FORS_PK_From_Sig (S       : in FORS_Sig;
                                 MD      : in Bytes_MD;
                                 PK_Seed : in Bytes_N;
                                 Adr     : in ADRS_Bytes) return Bytes_N
        with Global => null,
             Post   =>
               FORS_PK_From_Sig'Result =
                 Hash.T_L (PK_Seed, Roots_ADRS (Adr), Flatten (Roots_From_Sig (S, MD, PK_Seed, Adr)));

      ------------------------------------------------------
      --  Correctness of FORS
      --
      --  The FORS public key is T_k of the roots of the K
      --  trees. FIPS 205 has no function for this, since the
      --  FORS public key is only ever computed from a signature.
      --  The public key computed from a valid signature of any
      --  md is the FORS public key.
      ------------------------------------------------------

      --  The roots of the K trees
      function PK_Roots (SK_Seed : in Bytes_N;
                         PK_Seed : in Bytes_N;
                         Adr     : in ADRS_Bytes) return FORS_Roots
        with Ghost,
             Global => null,
             Post   => (for all I in FORS_Tree_Index =>
                          PK_Roots'Result (I) = FORS_Node (SK_Seed, U32 (I), A, PK_Seed, Adr));

      --  The FORS public key
      function FORS_PK (SK_Seed : in Bytes_N;
                        PK_Seed : in Bytes_N;
                        Adr     : in ADRS_Bytes) return Bytes_N
      is (Hash.T_L (PK_Seed, Roots_ADRS (Adr), Flatten (PK_Roots (SK_Seed, PK_Seed, Adr))))
        with Ghost,
             Global => null;

      procedure Theorem_Round_Trip (MD      : in Bytes_MD;
                                    SK_Seed : in Bytes_N;
                                    PK_Seed : in Bytes_N;
                                    Adr     : in ADRS_Bytes)
        with Ghost,
             Global => null,
             Post   => FORS_PK_From_Sig (FORS_Sign (MD, SK_Seed, PK_Seed, Adr), MD, PK_Seed, Adr) =
                         FORS_PK (SK_Seed, PK_Seed, Adr);
   end FORS;

   --==============================================
   --  Byte formats of signatures
   --  See FIPS 205 Figures 11, 13, 14 and 17
   --
   --  Conversions between the structured signature
   --  types used above and their byte formats. For
   --  each pair, From_Bytes (To_Bytes (S)) = S.
   --==============================================

   --  SIG_XMSS = sig || AUTH (Figure 11)
   XMSS_Sig_Bytes : constant := (Len + H_Tick) * N;
   subtype Index_XMSS_Sig is N32 range 0 .. XMSS_Sig_Bytes - 1;
   subtype Bytes_XMSS_Sig is Byte_Seq (Index_XMSS_Sig);

   --  SIG_HT, the XMSS signatures of layers 0 to d - 1 (Figure 13)
   HT_Sig_Bytes : constant := D * XMSS_Sig_Bytes;
   subtype Index_HT_Sig is N32 range 0 .. HT_Sig_Bytes - 1;
   subtype Bytes_HT_Sig is Byte_Seq (Index_HT_Sig);

   --  One private key value and its AUTH (Figure 14)
   FORS_Elem_Bytes : constant := (A + 1) * N;
   subtype Index_FORS_Elem is N32 range 0 .. FORS_Elem_Bytes - 1;
   subtype Bytes_FORS_Elem is Byte_Seq (Index_FORS_Elem);

   --  SIG_FORS, the elements for trees 0 to k - 1 (Figure 14)
   FORS_Sig_Bytes : constant := K * FORS_Elem_Bytes;
   subtype Index_FORS_Sig is N32 range 0 .. FORS_Sig_Bytes - 1;
   subtype Bytes_FORS_Sig is Byte_Seq (Index_FORS_Sig);

   --  SIG = R || SIG_FORS || SIG_HT (Figure 17). Signature is
   --  declared in the visible part
   pragma Assert (Sig_Bytes = N + FORS_Sig_Bytes + HT_Sig_Bytes);

   --  Where each part of SIG starts
   FORS_Start : constant := N;
   HT_Start   : constant := N + FORS_Sig_Bytes;

   package Formats
   is
      ------------------------------------------------------
      --  XMSS signatures
      ------------------------------------------------------
      function XMSS_To_Bytes (S : in XMSS_Sig) return Bytes_XMSS_Sig
        with Global => null,
             Post   =>
               (for all I in Index_Len =>
                  (for all B in Index_N => XMSS_To_Bytes'Result (I * N + B) = S.Sig (I) (B))) and
               (for all J in Auth_Index =>
                  (for all B in Index_N => XMSS_To_Bytes'Result (Len * N + J * N + B) = S.Auth (J) (B)));

      function XMSS_From_Bytes (X : in Bytes_XMSS_Sig) return XMSS_Sig
        with Global => null,
             Post   =>
               (for all I in Index_Len =>
                  (for all B in Index_N => XMSS_From_Bytes'Result.Sig (I) (B) = X (I * N + B))) and
               (for all J in Auth_Index =>
                  (for all B in Index_N => XMSS_From_Bytes'Result.Auth (J) (B) = X (Len * N + J * N + B)));

      --  Parsing the bytes of S gives S
      procedure Lemma_XMSS_Bytes (X : in Bytes_XMSS_Sig; S : in XMSS_Sig)
        with Ghost,
             Global => null,
             Pre    => X = XMSS_To_Bytes (S),
             Post   => XMSS_From_Bytes (X) = S;

      ------------------------------------------------------
      --  Hypertree signatures
      ------------------------------------------------------
      function HT_To_Bytes (S : in HT_Sig) return Bytes_HT_Sig
        with Global => null,
             Post   =>
               (for all J in Layer_Index =>
                  HT_To_Bytes'Result (J * XMSS_Sig_Bytes .. J * XMSS_Sig_Bytes + XMSS_Sig_Bytes - 1) =
                    XMSS_To_Bytes (S (J)));

      function HT_From_Bytes (X : in Bytes_HT_Sig) return HT_Sig
        with Global => null,
             Post   =>
               (for all J in Layer_Index =>
                  HT_From_Bytes'Result (J) =
                    XMSS_From_Bytes (X (J * XMSS_Sig_Bytes .. J * XMSS_Sig_Bytes + XMSS_Sig_Bytes - 1)));

      --  Parsing the bytes of S gives S
      procedure Lemma_HT_Bytes (X : in Bytes_HT_Sig; S : in HT_Sig)
        with Ghost,
             Global => null,
             Pre    => X = HT_To_Bytes (S),
             Post   => HT_From_Bytes (X) = S;

      ------------------------------------------------------
      --  FORS signatures
      ------------------------------------------------------
      function FORS_Elem_To_Bytes (E : in FORS_Elem) return Bytes_FORS_Elem
        with Global => null,
             Post   =>
               (for all B in Index_N => FORS_Elem_To_Bytes'Result (B) = E.SK (B)) and
               (for all J in FORS_Auth_Index =>
                  (for all B in Index_N => FORS_Elem_To_Bytes'Result (N + J * N + B) = E.Auth (J) (B)));

      function FORS_Elem_From_Bytes (X : in Bytes_FORS_Elem) return FORS_Elem
        with Global => null,
             Post   =>
               (for all B in Index_N => FORS_Elem_From_Bytes'Result.SK (B) = X (B)) and
               (for all J in FORS_Auth_Index =>
                  (for all B in Index_N => FORS_Elem_From_Bytes'Result.Auth (J) (B) = X (N + J * N + B)));

      --  Parsing the bytes of E gives E
      procedure Lemma_FORS_Elem_Bytes (X : in Bytes_FORS_Elem; E : in FORS_Elem)
        with Ghost,
             Global => null,
             Pre    => X = FORS_Elem_To_Bytes (E),
             Post   => FORS_Elem_From_Bytes (X) = E;

      function FORS_To_Bytes (S : in FORS_Sig) return Bytes_FORS_Sig
        with Global => null,
             Post   =>
               (for all I in FORS_Tree_Index =>
                  FORS_To_Bytes'Result (I * FORS_Elem_Bytes .. I * FORS_Elem_Bytes + FORS_Elem_Bytes - 1) =
                    FORS_Elem_To_Bytes (S (I)));

      function FORS_From_Bytes (X : in Bytes_FORS_Sig) return FORS_Sig
        with Global => null,
             Post   =>
               (for all I in FORS_Tree_Index =>
                  FORS_From_Bytes'Result (I) =
                    FORS_Elem_From_Bytes (X (I * FORS_Elem_Bytes .. I * FORS_Elem_Bytes + FORS_Elem_Bytes - 1)));

      --  Parsing the bytes of S gives S
      procedure Lemma_FORS_Bytes (X : in Bytes_FORS_Sig; S : in FORS_Sig)
        with Ghost,
             Global => null,
             Pre    => X = FORS_To_Bytes (S),
             Post   => FORS_From_Bytes (X) = S;

      ------------------------------------------------------
      --  SLH-DSA signatures. SIG.getR (), SIG.getSIG_FORS ()
      --  and SIG.getSIG_HT () from Algorithm 20 lines 5 to 7
      --
      --  These are not expression functions, since compiling
      --  an expression function that returns a slice of S
      --  crashes GNAT 16.1 ("GNAT BUG DETECTED ...
      --  Constraint_Error erroneous memory access")
      ------------------------------------------------------
      function Get_R (S : in Signature) return Bytes_N
        with Global => null,
             Post   => (for all B in Index_N => Get_R'Result (B) = S (B));

      function Get_SIG_FORS (S : in Signature) return Bytes_FORS_Sig
        with Global => null,
             Post   => Get_SIG_FORS'Result = S (FORS_Start .. HT_Start - 1);

      function Get_SIG_HT (S : in Signature) return Bytes_HT_Sig
        with Global => null,
             Post   => Get_SIG_HT'Result = S (HT_Start .. Sig_Bytes - 1);
   end Formats;

   --==============================================
   --  SLH-DSA internal functions
   --  See FIPS 205 section 9
   --
   --  FIPS 205 says that, other than for testing,
   --  these functions should not be made available
   --  to applications, so they are declared in the
   --  private part. Random inputs (SK.seed, SK.prf,
   --  PK.seed and addrnd) are parameters.
   --==============================================

   --  SK, the private key (Figure 15)
   type SK_Parts is record
      SK_Seed : Bytes_N;
      SK_Prf  : Bytes_N;
      PK_Seed : Bytes_N;
      PK_Root : Bytes_N;
   end record;

   --  PK, the public key (Figure 16)
   type PK_Parts is record
      PK_Seed : Bytes_N;
      PK_Root : Bytes_N;
   end record;

   type Key_Parts is record
      SK : SK_Parts;
      PK : PK_Parts;
   end record;

   --  A message. M'First = 0 is required by H_msg and PRF_msg
   function Valid_Internal_Message (Msg : in Byte_Seq) return Boolean
   is (Msg'First = 0 and Msg'Last <= I32'Last - 1)
     with Global => null;

   --  The parts of the message digest. See Algorithm 19 lines 6 to 10,
   --  and Algorithm 20 lines 9 to 13
   type Digest_Parts is record
      MD       : Bytes_MD;
      Idx_Tree : Tree_Index;
      Idx_Leaf : Node_Index;
   end record;

   --  Lines 6 to 10 of Algorithm 19, and lines 9 to 13 of Algorithm 20
   function Split_Digest (Digest : in Bytes_M) return Digest_Parts
     with Global => null;

   --  The digest of a message, lines 5 to 10 of Algorithm 19 and
   --  lines 8 to 13 of Algorithm 20
   function Digest_Of (Msg     : in Byte_Seq;
                       R       : in Bytes_N;
                       PK_Seed : in Bytes_N;
                       PK_Root : in Bytes_N) return Digest_Parts
   is (Split_Digest (Hash.H_Msg (R, PK_Seed, PK_Root, Msg)))
     with Global => null,
          Pre    => Valid_Internal_Message (Msg);

   --  The address of the FORS key, lines 11 to 13 of Algorithm 19 and
   --  lines 14 to 16 of Algorithm 20:
   --    ADRS <- toByte (0, 32)
   --    ADRS.setTreeAddress (idx_tree)
   --    ADRS.setTypeAndClear (FORS_TREE)
   --    ADRS.setKeyPairAddress (idx_leaf)
   function FORS_ADRS (P : in Digest_Parts) return ADRS_Bytes
     with Global => null;

   --  R, the randomizer. Algorithm 19 lines 2 and 3
   function Randomizer (Msg      : in Byte_Seq;
                        SK       : in SK_Parts;
                        Opt_Rand : in Bytes_N) return Bytes_N
   is (Hash.PRF_Msg (SK.SK_Prf, Opt_Rand, Msg))
     with Global => null,
          Pre    => Valid_Internal_Message (Msg);

   --  PK.root for SK.seed and PK.seed: the root of the XMSS tree at
   --  the top layer. Algorithm 18 lines 1 to 3. Setting the tree
   --  address to 0 does not change toByte (0, 32), so the ADRS of
   --  lines 1 and 2 is HT.Layer_ADRS (d - 1, 0)
   function Root_Of (SK_Seed : in Bytes_N; PK_Seed : in Bytes_N) return Bytes_N
   is (XMSS.XMSS_Node (SK_Seed, 0, H_Tick, PK_Seed, HT.Layer_ADRS (D - 1, 0)))
     with Global => null;

   ------------------------------------------------------
   --  Algorithm 18. slh_keygen_internal (SK.seed, SK.prf, PK.seed)
   ------------------------------------------------------
   function SLH_Keygen_Internal (SK_Seed : in Bytes_N;
                                 SK_Prf  : in Bytes_N;
                                 PK_Seed : in Bytes_N) return Key_Parts
     with Global => null,
          Post   =>
            SLH_Keygen_Internal'Result =
              (SK => (SK_Seed => SK_Seed,
                      SK_Prf  => SK_Prf,
                      PK_Seed => PK_Seed,
                      PK_Root => Root_Of (SK_Seed, PK_Seed)),
               PK => (PK_Seed => PK_Seed,
                      PK_Root => Root_Of (SK_Seed, PK_Seed)));

   ------------------------------------------------------
   --  Algorithm 19. slh_sign_internal (M, SK, addrnd)
   --
   --  The hedged variant, with opt_rand = Addrnd. The
   --  postcondition gives each part of SIG.
   ------------------------------------------------------
   function SLH_Sign_Internal (Msg    : in Byte_Seq;
                               SK     : in SK_Parts;
                               Addrnd : in Bytes_N) return Signature
     with Global => null,
          Pre    => Valid_Internal_Message (Msg),
          Post   =>
            Formats.Get_R (SLH_Sign_Internal'Result) = Randomizer (Msg, SK, Addrnd) and
            Formats.FORS_From_Bytes (Formats.Get_SIG_FORS (SLH_Sign_Internal'Result)) =
              FORS.FORS_Sign (Digest_Of (Msg, Randomizer (Msg, SK, Addrnd), SK.PK_Seed, SK.PK_Root).MD,
                              SK.SK_Seed,
                              SK.PK_Seed,
                              FORS_ADRS (Digest_Of (Msg, Randomizer (Msg, SK, Addrnd),
                                                    SK.PK_Seed, SK.PK_Root))) and
            Formats.HT_From_Bytes (Formats.Get_SIG_HT (SLH_Sign_Internal'Result)) =
              HT.HT_Sign
                (FORS.FORS_PK_From_Sig
                   (FORS.FORS_Sign (Digest_Of (Msg, Randomizer (Msg, SK, Addrnd), SK.PK_Seed, SK.PK_Root).MD,
                                    SK.SK_Seed,
                                    SK.PK_Seed,
                                    FORS_ADRS (Digest_Of (Msg, Randomizer (Msg, SK, Addrnd),
                                                          SK.PK_Seed, SK.PK_Root))),
                    Digest_Of (Msg, Randomizer (Msg, SK, Addrnd), SK.PK_Seed, SK.PK_Root).MD,
                    SK.PK_Seed,
                    FORS_ADRS (Digest_Of (Msg, Randomizer (Msg, SK, Addrnd), SK.PK_Seed, SK.PK_Root))),
                 SK.SK_Seed,
                 SK.PK_Seed,
                 Digest_Of (Msg, Randomizer (Msg, SK, Addrnd), SK.PK_Seed, SK.PK_Root).Idx_Tree,
                 Digest_Of (Msg, Randomizer (Msg, SK, Addrnd), SK.PK_Seed, SK.PK_Root).Idx_Leaf);

   --  The deterministic variant, with opt_rand = PK.seed
   --  (Algorithm 19 line 2)
   function SLH_Sign_Internal_Deterministic (Msg : in Byte_Seq;
                                             SK  : in SK_Parts) return Signature
     with Global => null,
          Pre    => Valid_Internal_Message (Msg),
          Post   => SLH_Sign_Internal_Deterministic'Result = SLH_Sign_Internal (Msg, SK, SK.PK_Seed);

   ------------------------------------------------------
   --  Algorithm 20. slh_verify_internal (M, SIG, PK)
   --
   --  SIG is a Signature, so it always has the length
   --  checked in lines 1 to 3.
   ------------------------------------------------------
   function SLH_Verify_Internal (Msg : in Byte_Seq;
                                 Sig : in Signature;
                                 PK  : in PK_Parts) return Boolean
     with Global => null,
          Pre    => Valid_Internal_Message (Msg),
          Post   =>
            SLH_Verify_Internal'Result =
              HT.HT_Verify
                (FORS.FORS_PK_From_Sig
                   (Formats.FORS_From_Bytes (Formats.Get_SIG_FORS (Sig)),
                    Digest_Of (Msg, Formats.Get_R (Sig), PK.PK_Seed, PK.PK_Root).MD,
                    PK.PK_Seed,
                    FORS_ADRS (Digest_Of (Msg, Formats.Get_R (Sig), PK.PK_Seed, PK.PK_Root))),
                 Formats.HT_From_Bytes (Formats.Get_SIG_HT (Sig)),
                 PK.PK_Seed,
                 Digest_Of (Msg, Formats.Get_R (Sig), PK.PK_Seed, PK.PK_Root).Idx_Tree,
                 Digest_Of (Msg, Formats.Get_R (Sig), PK.PK_Seed, PK.PK_Root).Idx_Leaf,
                 PK.PK_Root);

   ------------------------------------------------------
   --  Correctness of SLH-DSA
   --
   --  A signature of any message, made with a private key
   --  from SLH_Keygen_Internal, verifies with the matching
   --  public key, for any addrnd. By the postcondition of
   --  SLH_Sign_Internal_Deterministic, this also covers
   --  the deterministic variant.
   ------------------------------------------------------
   procedure Theorem_Correctness (SK_Seed : in Bytes_N;
                                  SK_Prf  : in Bytes_N;
                                  PK_Seed : in Bytes_N;
                                  Msg     : in Byte_Seq;
                                  Addrnd  : in Bytes_N)
     with Ghost,
          Global => null,
          Pre    => Valid_Internal_Message (Msg),
          Post   =>
            SLH_Verify_Internal
              (Msg,
               SLH_Sign_Internal (Msg, SLH_Keygen_Internal (SK_Seed, SK_Prf, PK_Seed).SK, Addrnd),
               SLH_Keygen_Internal (SK_Seed, SK_Prf, PK_Seed).PK);

   --==============================================
   --  Support for the external functions
   --  See FIPS 205 section 10
   --==============================================

   ------------------------------------------------------
   --  Byte formats of keys (Figures 15 and 16)
   ------------------------------------------------------
   function SK_To_Bytes (S : in SK_Parts) return Private_Key
     with Global => null,
          Post   => (for all B in Index_N =>
                       SK_To_Bytes'Result (B) = S.SK_Seed (B) and
                       SK_To_Bytes'Result (N + B) = S.SK_Prf (B) and
                       SK_To_Bytes'Result (2 * N + B) = S.PK_Seed (B) and
                       SK_To_Bytes'Result (3 * N + B) = S.PK_Root (B));

   function SK_From_Bytes (X : in Private_Key) return SK_Parts
     with Global => null,
          Post   => (for all B in Index_N =>
                       SK_From_Bytes'Result.SK_Seed (B) = X (B) and
                       SK_From_Bytes'Result.SK_Prf (B) = X (N + B) and
                       SK_From_Bytes'Result.PK_Seed (B) = X (2 * N + B) and
                       SK_From_Bytes'Result.PK_Root (B) = X (3 * N + B));

   function PK_To_Bytes (P : in PK_Parts) return Public_Key
     with Global => null,
          Post   => (for all B in Index_N =>
                       PK_To_Bytes'Result (B) = P.PK_Seed (B) and
                       PK_To_Bytes'Result (N + B) = P.PK_Root (B));

   function PK_From_Bytes (X : in Public_Key) return PK_Parts
     with Global => null,
          Post   => (for all B in Index_N =>
                       PK_From_Bytes'Result.PK_Seed (B) = X (B) and
                       PK_From_Bytes'Result.PK_Root (B) = X (N + B));

   --  Parsing the bytes of S gives S
   procedure Lemma_SK_Bytes (X : in Private_Key; S : in SK_Parts)
     with Ghost,
          Global => null,
          Pre    => X = SK_To_Bytes (S),
          Post   => SK_From_Bytes (X) = S;

   procedure Lemma_PK_Bytes (X : in Public_Key; P : in PK_Parts)
     with Ghost,
          Global => null,
          Pre    => X = PK_To_Bytes (P),
          Post   => PK_From_Bytes (X) = P;

   ------------------------------------------------------
   --  M', the message given to the internal functions
   ------------------------------------------------------

   --  The DER encoding of the OID of a pre-hash function
   --  (Algorithm 23 lines 8 to 23, and Algorithm 25 lines 4 to 19)
   OID_Bytes : constant := 11;
   subtype Index_OID is I32 range 0 .. OID_Bytes - 1;
   subtype Bytes_OID is Byte_Seq (Index_OID);

   type OID_Table is array (Pre_Hash_Function) of Bytes_OID;

   OIDs : constant OID_Table :=
     (PH_SHA3_512 =>   --  2.16.840.1.101.3.4.2.10
        (16#06#, 16#09#, 16#60#, 16#86#, 16#48#, 16#01#, 16#65#, 16#03#, 16#04#, 16#02#, 16#0A#),
      PH_SHAKE256 =>   --  2.16.840.1.101.3.4.2.12
        (16#06#, 16#09#, 16#60#, 16#86#, 16#48#, 16#01#, 16#65#, 16#03#, 16#04#, 16#02#, 16#0C#));

   --  Length of M' in the pre-hash versions, less |ctx|
   Pre_Hash_Message_Length : constant := 2 + OID_Bytes + 64;

   --  True if X is M' for the pure versions (Algorithm 22 line 8,
   --  and Algorithm 24 line 4):
   --    M' = toByte (0, 1) || toByte (|ctx|, 1) || ctx || M
   function Is_Pure_Message (X : in Byte_Seq; Msg : in Byte_Seq; Ctx : in Byte_Seq) return Boolean
   is (X'First = 0 and then
       X'Length = 2 + Ctx'Length + Msg'Length and then
       X (0) = 0 and then
       X (1) = Byte (Ctx'Length) and then
       (for all I in I32 range 0 .. Ctx'Length - 1 => X (2 + I) = Ctx (Ctx'First + I)) and then
       (for all I in I32 range 0 .. Msg'Length - 1 =>
          X (2 + Ctx'Length + I) = Msg (Msg'First + I)))
     with Ghost,
          Global => null,
          Pre    => Valid_Context (Ctx) and Valid_Pure_Message (Msg);

   --  True if X is M' for the pre-hash versions (Algorithm 23 line 24,
   --  and Algorithm 25 line 20):
   --    M' = toByte (1, 1) || toByte (|ctx|, 1) || ctx || OID || PH_M
   function Is_Pre_Hash_Message (X    : in Byte_Seq;
                                 Ctx  : in Byte_Seq;
                                 OID  : in Bytes_OID;
                                 PH_M : in Bytes_64) return Boolean
   is (X'First = 0 and then
       X'Length = Pre_Hash_Message_Length + Ctx'Length and then
       X (0) = 1 and then
       X (1) = Byte (Ctx'Length) and then
       (for all I in I32 range 0 .. Ctx'Length - 1 => X (2 + I) = Ctx (Ctx'First + I)) and then
       (for all I in Index_OID => X (2 + Ctx'Length + I) = OID (I)) and then
       (for all I in Index_64 => X (2 + Ctx'Length + OID_Bytes + I) = PH_M (I)))
     with Ghost,
          Global => null,
          Pre    => Valid_Context (Ctx);

   --  M' is unique
   procedure Lemma_Pure_Message_Unique (X, Y : in Byte_Seq; Msg : in Byte_Seq; Ctx : in Byte_Seq)
     with Ghost,
          Global => null,
          Pre    => Valid_Context (Ctx) and then
                    Valid_Pure_Message (Msg) and then
                    Is_Pure_Message (X, Msg, Ctx) and then
                    Is_Pure_Message (Y, Msg, Ctx),
          Post   => X'First = Y'First and X'Last = Y'Last and X = Y;

   procedure Lemma_Pre_Hash_Message_Unique (X, Y : in Byte_Seq;
                                            Ctx  : in Byte_Seq;
                                            OID  : in Bytes_OID;
                                            PH_M : in Bytes_64)
     with Ghost,
          Global => null,
          Pre    => Valid_Context (Ctx) and then
                    Is_Pre_Hash_Message (X, Ctx, OID, PH_M) and then
                    Is_Pre_Hash_Message (Y, Ctx, OID, PH_M),
          Post   => X'First = Y'First and X'Last = Y'Last and X = Y;

   --  Builds M' for the pure versions in M_Prime, a buffer of the
   --  right length provided by the caller
   procedure Build_Pure_Message (Msg     : in     Byte_Seq;
                                 Ctx     : in     Byte_Seq;
                                 M_Prime :    out Byte_Seq)
     with Global => null,
          Pre    => Valid_Context (Ctx) and then
                    Valid_Pure_Message (Msg) and then
                    M_Prime'First = 0 and then
                    M_Prime'Length = 2 + Ctx'Length + Msg'Length,
          Post   => Is_Pure_Message (M_Prime, Msg, Ctx);

   --  Builds M' for the pre-hash versions in M_Prime
   procedure Build_Pre_Hash_Message (Ctx     : in     Byte_Seq;
                                     OID     : in     Bytes_OID;
                                     PH_M    : in     Bytes_64;
                                     M_Prime :    out Byte_Seq)
     with Global => null,
          Pre    => Valid_Context (Ctx) and then
                    M_Prime'First = 0 and then
                    M_Prime'Length = Pre_Hash_Message_Length + Ctx'Length,
          Post   => Is_Pre_Hash_Message (M_Prime, Ctx, OID, PH_M);

   --  M' for the pure versions, as a value. These ghost functions
   --  return unconstrained arrays, so they are only used in proofs
   function Pure_Message (Msg : in Byte_Seq; Ctx : in Byte_Seq) return Byte_Seq
     with Ghost,
          Global => null,
          Pre    => Valid_Context (Ctx) and Valid_Pure_Message (Msg),
          Post   => Is_Pure_Message (Pure_Message'Result, Msg, Ctx);

   --  M' for the pre-hash versions, as a value
   function Pre_Hash_Message (Msg : in Byte_Seq; Ctx : in Byte_Seq; PH : in Pre_Hash_Function)
                              return Byte_Seq
     with Ghost,
          Global => null,
          Pre    => Valid_Context (Ctx) and Valid_Pre_Hash_Message (Msg),
          Post   => Is_Pre_Hash_Message (Pre_Hash_Message'Result, Ctx, OIDs (PH),
                                         Hash.Pre_Hash (PH, Msg));

end SLH;
